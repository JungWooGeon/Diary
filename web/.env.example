# Google OAuth web client id (GIS token model, scope drive.appdata). Public value, no secret.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# oni-api (Cloudflare Worker, docs/v2/SERVER.md) — keeps the web login alive and links premium. Empty = token-model only (1h login).
VITE_API_BASE=https://oni-api.example.workers.dev
# Google AdSense publisher id and banner slot. Empty = no ads, no AdSense script, no verification meta.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_BANNER=0000000000
VITE_ADSENSE_SLOT_FEED=0000000000
VITE_ADSENSE_FEED_LAYOUT=
