{
 "version": 1,
 "doc": [
  "LLM 출력 후처리 검사. 구현: core/ai (Kotlin OutputFilter), tools/model-eval/filters.py (Python). 둘 다 아래 testCases를 통과해야 한다.",
  "정규식은 Java/Python 공통 문법만 쓴다(가변 길이 lookbehind 없음). 'text' = 출력, 'input' = 모델에 넣은 원문(일기/받아쓰기). entities 테스트는 tags.json people 사전을 넣고 돌린다.",
  "전처리: quoted = 출력에서 따옴표('…', \"…\", ‘…’, “…”, 「…」) 안 내용을 지운 것. sentences = quoted를 [.!?…\\n]+ 뒤에서 자르고 빈 조각을 버린 것.",
  "검사에 하나라도 걸리면: 한 번 다시 생성 → 또 걸리면 문구 라이브러리 답장(또는 원문 그대로)."
 ],
 "rules": {
  "banmal": {
   "kind": "sentenceEndForbid",
   "doc": "존댓말 끝맺음. quoted의 각 문장 끝(뒤쪽 공백·문장부호·~·ㅎ·ㅋ·ㅠ 제거 후)이 pattern에 맞으면 실패. allow에 맞으면 통과.",
   "pattern": "(요|세요|습니다|습니까|십시오|니다|죠)$",
   "allow": "(필요|중요|불필요)$"
  },
  "script": {
   "kind": "charForbid",
   "doc": "다른 문자 섞임. forbid 글자가 하나라도 있으면 실패. 라틴 낱말([A-Za-z]+)은 input에 (대소문자 무시) 있거나 latinAllow에 있을 때만 허용.",
   "forbid": "[\\u4E00-\\u9FFF\\u3400-\\u4DBF\\uF900-\\uFAFF\\u3040-\\u30FF\\u0400-\\u04FF\\u0E00-\\u0E7F\\u0600-\\u06FF\\u00C0-\\u024F]",
   "latin": "[A-Za-z]+",
   "latinAllow": [
    "kg",
    "km",
    "cm",
    "mm",
    "g",
    "ml",
    "l",
    "pt",
    "ok",
    "ppt",
    "sns",
    "kakao",
    "kt",
    "ktx",
    "pc"
   ]
  },
  "sentences_2_4": {
   "kind": "sentenceCount",
   "min": 2,
   "max": 4
  },
  "sentences_3_6": {
   "kind": "sentenceCount",
   "min": 3,
   "max": 6
  },
  "questions_max_1": {
   "kind": "questionCount",
   "doc": "quoted의 '?' 개수 ≤ max, 그리고 '?'가 있으면 마지막 문장에만.",
   "min": 0,
   "max": 1
  },
  "questions_exactly_1": {
   "kind": "questionCount",
   "min": 1,
   "max": 1
  },
  "length_title": {
   "kind": "length",
   "doc": "공백 포함 글자 수(코드포인트)",
   "min": 2,
   "max": 20,
   "forbid": "[\"'“”‘’.!?\\n]"
  },
  "length_question": {
   "kind": "length",
   "min": 5,
   "max": 50
  },
  "banned_reply": {
   "kind": "regexForbid",
   "doc": "진단·훈계·조언형. anywhere는 출력 어디서든, lastSentence는 마지막 문장(끝 문장부호 제거 후)에만 적용.",
   "anywhere": [
    "(우울증|불안장애|공황장애|조울증|양극성|번아웃|ADHD|강박증|트라우마|정신질환|정신과)",
    "(상담|치료)(을|를)? ?(받아|받는|받으|해 ?봐)",
    "는 ?(게|것이) ?(제일 |가장 |더 )?(중요|좋아|필요|낫)",
    "야 ?(해|돼|한다)([\\s.!?~]|$)",
    "(AI|인공지능|언어 ?모델)(이라서|로서|이기)",
    "(자책|걱정|신경 ?쓰|무리|포기)(하)?지 ?마",
    "(해|봐|와|써|줘|먹어|쉬어|말해|생각해|찾아|정리해|적어|집중해|가져) ?봐([\\s.!~,]|$)"
   ],
   "lastSentence": [
    "(보는|하는|는) ?(건|게) 어때$",
    "하지 ?마$",
    "(힘내|힘 내|파이팅|화이팅)$"
   ]
  },
  "entities": {
   "kind": "entitiesInInput",
   "doc": "출력에 나온 이름·숫자가 input에 있어야 한다. 조사·어미·호칭 차이와 보통명사는 봐준다(꾸며 낸 고유 이름·바뀐 숫자만 잡는다). (1) 숫자: 출력의 [0-9]+(\\.[0-9]+)? 마다 input의 숫자 집합에 있어야 함. input 숫자 집합 = input의 아라비아 숫자 + sinoNumeral에 맞는 덩어리(앞에 한글이 없고 뒤에 공백·숫자·단위가 올 때만: '오늘'의 '오'는 5가 아니다) 하나하나의 값(십·백·천·만이 있으면 자릿값 계산, 없으면 숫자를 이어 붙임, '점' 뒤는 소수. '점'은 점수 단위일 수도 있으니 정수 부분 값도 함께 넣는다) + nativeNumbers 낱말 뒤에 nativeUnit이 오면 그 값. (2) 이름: namePatterns(OO이가/OO이랑, OO님/쌤. 조사 없는 'OO이 '는 '기운이 '와 구별이 안 돼서 보지 않는다) 그룹1(어간)에서 끝의 '들'을 떼고, nameStop이나 people 사전 낱말이면 건너뛴다. 아니면 input에 (공백 무시) 있어야 함. (3) people 사전(tags.json people, tag+aliases 한 묶음): 2글자 이상이고 peopleIgnore가 아닌 낱말이, 어절 첫머리에서 시작해 뒤에 peopleJosa만 붙은 꼴로 출력에 나오면(앞뒤 한글 없음) — 같은 묶음 낱말 하나가 input에 있거나, 그 낱말에서 honorifics 접미를 뗀 어간(2글자 이상)이 input에 있으면 통과. peopleGeneric 묶음(친구·가족처럼 보통명사)은 검사하지 않는다.",
   "namePatterns": [
    "(?<![가-힣])([가-힣]{2,3})이(가|랑|는|한테|를|도|의|와|하고|에게)",
    "(?<![가-힣])([가-힣]{1,4})(님|씨|쌤|선배|후배)"
   ],
   "nameStop": [
    "우리",
    "그",
    "이",
    "저",
    "누구",
    "아무",
    "선생",
    "여러분",
    "친구",
    "사람",
    "생각",
    "기분",
    "마음",
    "하루",
    "오늘",
    "시간",
    "가족",
    "동기",
    "원장",
    "담임",
    "기사",
    "사장",
    "교수",
    "의사"
   ],
   "sinoNumeral": "(?<![가-힣])[영공일이삼사오육칠팔구십백천만]+(?:\\s?점\\s?[영공일이삼사오육칠팔구]+)?(?=[\\s0-9]|분|시|초|년|개|월|일|층|번|호|등|명|살|점|키로|킬로|원|주|학년|교시|퍼센트|대|회|차|박|$)",
   "nativeNumbers": {
    "한": 1,
    "두": 2,
    "세": 3,
    "네": 4,
    "다섯": 5,
    "여섯": 6,
    "일곱": 7,
    "여덟": 8,
    "아홉": 9,
    "열": 10,
    "스무": 20,
    "스물": 20
   },
   "nativeUnit": "(\\s|시|개|명|번|살|달|잔|병|권|마리|장|시간)",
   "peopleJosa": "(님|들|께서|에서|한테서|한테|에게|이랑|랑|하고|와|과|은|는|이|가|을|를|도|만|께|네|의|으로|로|까지|부터|처럼|보다|이나|나|야|아|이야|라고|이라고)*",
   "peopleIgnore": [
    "같이",
    "타는",
    "사람",
    "좋아하는",
    "알바하는",
    "썸"
   ],
   "peopleGeneric": [
    "친구",
    "가족",
    "동료",
    "이웃",
    "모르는사람",
    "고객",
    "아이돌",
    "반려동물"
   ],
   "honorifics": [
    "선생님",
    "님",
    "쌤",
    "샘",
    "씨"
   ]
  },
  "sentences_3_8": {
   "kind": "sentenceCount",
   "min": 3,
   "max": 8
  }
 },
